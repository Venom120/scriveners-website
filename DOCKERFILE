FROM python:3.11-slim

# Install Nginx + Python deps
RUN apt-get update && apt-get install -y nginx supervisor && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/req.txt ./backend/
RUN pip install --upgrade pip && pip install --no-cache-dir -r backend/req.txt

COPY backend/ ./backend/

# Copy built frontend from stage 1
COPY ./dist /usr/share/nginx/html

# Remove the default Nginx site that shows the "Welcome" page.
RUN rm -f /etc/nginx/sites-enabled/default

# Copy our custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# --------------------------
# Supervisor config (runs both processes)
# --------------------------
RUN mkdir -p /var/log/supervisor
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80
EXPOSE 8100
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
